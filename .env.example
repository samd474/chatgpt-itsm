DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

POSTGRES_DB=itsm
POSTGRES_USER=itsm_app
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
# Production: REDIS_PASSWORD=<random> and REDIS_URL=redis://:<same>@redis:6379/0
REDIS_PASSWORD=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=itsm@example.local
# SMTP settings when EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

FRONTEND_URL=http://localhost:5173

# Production only: raise once HTTPS works for the real hostname.
DJANGO_HSTS_SECONDS=0

# Malware scanning (ClamAV). Required (fail closed) when DEBUG is off.
CLAMAV_HOST=
ATTACHMENT_SCAN_REQUIRED=0
